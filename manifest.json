{
  "manifest_version": 3,
  "name": "블로그 댓글 도우미",
  "version": "1.9.0",
  "description": "네이버 블로그 글을 읽고 AI가 댓글·답글 초안을 써 주고, 네이버 지도 장소 정보를 정리해 줍니다. 등록은 직접 누르세요.",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://*.pstatic.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://blog.naver.com/*",
        "https://m.blog.naver.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pcmap.place.naver.com/*",
        "https://m.place.naver.com/*"
      ],
      "js": [
        "place.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "댓글 도우미 설정"
  }
}